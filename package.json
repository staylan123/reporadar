{
  "name": "reporadar",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "backend\\.venv\\Scripts\\uvicorn.exe app.main:app --reload --app-dir backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
